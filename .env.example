# Punto App — variables de entorno del stack
# Copiar a .env y completar antes de levantar:  cp .env.example .env
# El .env NUNCA se commitea (architecture/02-security.md).

# --- Base de datos ---
POSTGRES_USER=punto
POSTGRES_PASSWORD=punto
POSTGRES_DB=punto
DATABASE_URL=postgresql+psycopg://punto:punto@db:5432/punto

# --- JWT (secreto por audiencia, ADR-003) ---
JWT_SECRET_STORE=change-me-store
JWT_SECRET_ADMIN=change-me-admin
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Ventana de deduplicación de visitas en horas (RN-08) ---
VISIT_DEDUP_WINDOW_HOURS=24

# --- CORS (separadas por coma) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Bootstrap del administrador inicial, solo primer arranque (ADR-006) ---
# ADMIN_INITIAL_USER es el email del admin. La contraseña debe cumplir RN-15:
# mínimo 8 caracteres, una mayúscula, un número y un caracter especial.
ADMIN_INITIAL_USER=admin@puntoapp.local
ADMIN_INITIAL_PASSWORD=Cambiar1!
ADMIN_INITIAL_DISPLAY_NAME=Administrador
